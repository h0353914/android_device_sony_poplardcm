on early-boot
    chown nfc nfc /dev/cxd224x-i2c
    chown nfc nfc /dev/bd7602-i2c
    start vendor.snfcboot

# CXD NFC firmware download daemon
service vendor.snfcboot /vendor/bin/snfcboot
    class core
    user nfc
    group nfc
    oneshot

# Sony CXD NFC HAL
service vendor.nfc_hal_service /vendor/bin/hw/android.hardware.nfc@1.2-service-cxd22xx
    class hal
    user nfc
    group nfc
