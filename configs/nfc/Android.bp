// Signer allowlist for FelicaService's NfceeAccessControl; from SO-01K docomo 47.2.B.5.38.
prebuilt_etc {
    name: "felica_access.xml",
    src: "felica_access.xml",
}

// Shared-library permissions declaration for com.felicanetworks.felica.
prebuilt_etc {
    name: "com.felicanetworks.felica.xml",
    src: "com.felicanetworks.felica.xml",
    sub_dir: "permissions",
}
